SERVICE=api-gateway
GATEWAY_HTTP_ADDR=127.0.0.1:7880
GATEWAY_CORS_ORIGINS=http://localhost:5173
AUTH_HTTP_ADDR=127.0.0.1:7881
AUTH_GRPC_ADDR=127.0.0.1:50051
USERS_GRPC_ADDR=127.0.0.1:50052
POSTS_GRPC_ADDR=127.0.0.1:50053
CHAT_GRPC_ADDR=127.0.0.1:50054
GATEWAY_ADMIN_ADDR=127.0.0.1:9880
AUTH_ADMIN_ADDR=127.0.0.1:9881
USERS_ADMIN_ADDR=127.0.0.1:9882
POSTS_ADMIN_ADDR=127.0.0.1:9883
CHAT_ADMIN_ADDR=127.0.0.1:9884
SHUTDOWN_GRACE_MS=1000
SHUTDOWN_DRAIN_MS=2000
STARTUP_WAIT_MS=10000
STARTUP_RETRY_MS=200
ACCESS_LOG=true
AUTH_ACCESS_TTL_SECS=900
AUTH_REFRESH_TTL_SECS=2592000
AUTH_MODERATORS=moder
# AUTH_SIGNING_KEYS=k2:<32+ байт base64url>,k1:<прошлый ключ> (без него ключ создаётся при старте)
CERTS_DIR=certs
SOCIAL_CA=certs/ca.pem
RUST_BACKTRACE=1
